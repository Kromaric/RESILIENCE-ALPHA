{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "jsx": "react-jsx",
    "checkJs": false
  },
  "include": ["frontend/src/**/*"],
  "exclude": ["**/node_modules", "frontend/dist"]
}
