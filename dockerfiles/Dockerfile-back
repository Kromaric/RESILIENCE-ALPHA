# -----------------------------------------------------------------------------
# Étape 1 : Construction des dépendances (Stage 1)
# -----------------------------------------------------------------------------
FROM python:3.11-slim AS builder

# Empêche Python d'écrire des fichiers .pyc sur le disque
ENV PYTHONDONTWRITEBYTECODE=1
# Empêche Python de mettre en mémoire tampon les sorties (logs en direct)
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Installation des dépendances système nécessaires à la compilation (si besoin)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copie uniquement le fichier de dépendances pour profiter du cache Docker
COPY requirements.txt .

# Installation des paquets Python dans un dossier utilisateur
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


# -----------------------------------------------------------------------------
# Étape 2 : Image finale de production (Stage 2)
# -----------------------------------------------------------------------------
FROM python:3.11-slim AS runner

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Création d'un utilisateur non-privilégié pour la sécurité
RUN addgroup --system appgroup && adduser --system --group appuser

# Copie des packages Python installés lors de l'étape précédente
COPY --from=builder /install /usr/local

# Copie du code source de l'application
COPY . .

# Modification des permissions pour l'utilisateur non-root
RUN chown -R appuser:appgroup /app

# Basculer vers l'utilisateur non-privilégié
USER appuser

# Exposer le port sur lequel l'application écoute
EXPOSE 8090

# Commande de démarrage de l'application
# Exemple pour un serveur Web (FastAPI/Uvicorn, Flask ou Gunicorn) :
CMD ["python", "main.py"]
