# syntax=docker/dockerfile:1
# assistant-rag (CADRAGE §4.8) — contexte de build : racine du dépôt
#   docker build -f dockerfiles/Dockerfile-assistant-rag -t orbe/assistant-rag .
#
# Le corpus docs/ n'est PAS copié dans l'image (exclu par .dockerignore) : il est monté en
# lecture seule sur /corpus, ce qui permet de mettre la documentation à jour sans reconstruire.
# Le modèle de langage n'est pas non plus dans l'image : il est servi par le conteneur ollama.

FROM python:3.12-slim AS build
WORKDIR /src
COPY services/assistant-rag/pyproject.toml ./
COPY services/assistant-rag/app ./app
RUN pip install --no-cache-dir --prefix=/install .

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    ANONYMIZED_TELEMETRY=False
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin orbe \
 && mkdir -p /data/chroma /corpus \
 && chown -R 10001:10001 /data
COPY --from=build /install /usr/local
USER 10001
EXPOSE 8005
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8005/health/live', timeout=2)"]
CMD ["uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8005", \
     "--no-access-log", "--no-server-header"]
