# -----------------------------------------------------------------------------
# Dashboard de supervision (back-office) — contexte de build : racine du dépôt
#   docker build -f dockerfiles/Dockerfile-dashboard -t orbe/dashboard .
# La page Documentation embarque docs/ au build : Dockerfile-dashboard.dockerignore
# remplace le .dockerignore de la racine pour l'autoriser.
# -----------------------------------------------------------------------------

# Étape 1 : construction de l'application React (Vite)
FROM node:20-alpine AS builder

WORKDIR /app/dashboard

# Dépendances d'abord, pour profiter du cache Docker
COPY dashboard/package*.json ./
RUN npm ci --no-audit --no-fund

# Code source, et la documentation lue au build (../docs depuis dashboard/)
COPY dashboard/ ./
COPY docs/ /app/docs/
RUN npm run build


# Étape 2 : Nginx non root (uid 101), port 8083
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runner

RUN echo 'server { \
    listen 8083; \
    server_name localhost; \
    server_tokens off; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dashboard/dist /usr/share/nginx/html

EXPOSE 8083

CMD ["nginx", "-g", "daemon off;"]
