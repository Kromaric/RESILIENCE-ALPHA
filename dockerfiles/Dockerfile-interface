# -----------------------------------------------------------------------------
# Application Orbe (clients) — contexte de build : racine du dépôt
#   docker build -f dockerfiles/Dockerfile-interface -t orbe/interface .
# -----------------------------------------------------------------------------

# Étape 1 : construction de l'application React (Vite)
FROM node:20-alpine AS builder

WORKDIR /app

# Dépendances d'abord, pour profiter du cache Docker
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./
RUN npm run build


# Étape 2 : Nginx non root (uid 101), port 8081 (attendu par le WAF)
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runner

RUN echo 'server { \
    listen 8081; \
    server_name localhost; \
    server_tokens off; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8081

CMD ["nginx", "-g", "daemon off;"]
