# -----------------------------------------------------------------------------
# Étape 1 : Construction de l'application React + Tailwind (Stage 1)
# -----------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Copie des fichiers de dépendances pour maximiser l'utilisation du cache Docker
COPY package*.json ./

# Installation des dépendances (y compris Tailwind CSS)
RUN npm ci

# Copie du  code source
COPY . .

# Compilation de l'application pour la production (génère le dossier /app/dist ou /app/build)
RUN npm run build


# -----------------------------------------------------------------------------
# Étape 2 : Image de production avec Nginx sur le port 8080 (Stage 2)
# -----------------------------------------------------------------------------
FROM nginx:alpine AS runner

# Copie d'une configuration Nginx sur mesure pour écouter sur le port 8080 et gérer le SPA routing
RUN echo 'server { \
    listen 8080; \
    server_name localhost; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html index.htm; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

# Copie des fichiers compilés depuis l'étape de build
# Remarque : Si vous utilisez Create React App au lieu de Vite, remplacez '/app/dist' par '/app/build'
COPY --from=builder /app/dist /usr/share/nginx/html

# Exposition du port 8080
EXPOSE 8080

# Démarrage de Nginx en arrière-plan
CMD ["nginx", "-g", "daemon off;"]
