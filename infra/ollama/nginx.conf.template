# Proxy devant Ollama (VM dédiée). ${OLLAMA_PROXY_TOKEN} est remplacé au démarrage par l'image
# nginx (envsubst) ; les variables nginx ($http_authorization…) ne sont pas touchées.

server {
    listen 11434;
    server_tokens off;
    client_max_body_size 1m;

    access_log /dev/stdout;
    error_log /dev/stderr warn;

    # Routes d'inférence et de lecture utilisées par assistant-rag (langchain-ollama).
    # Fermées : /api/pull, /api/push, /api/delete, /api/create, /api/copy, /api/blobs…
    location ~ ^/api/(chat|generate|embed|embeddings|show|tags|version|ps)$ {
        if ($http_authorization != "Bearer ${OLLAMA_PROXY_TOKEN}") {
            return 401;
        }
        proxy_pass http://ollama:11434;
        proxy_http_version 1.1;
        proxy_set_header Host localhost;
        proxy_set_header Authorization "";   # le jeton ne va pas plus loin
        proxy_buffering off;                  # réponses en flux
        proxy_read_timeout 300s;              # génération lente sur CPU
    }

    location = /health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 404;
    }
}
