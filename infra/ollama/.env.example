# Copier en .env sur la VM (fichier ignoré par Git). Ne jamais committer le jeton.

# Jeton exigé par le proxy : MÊME valeur que secrets/ollama_token sur le PC Hôte
# (généré par scripts/init_dev_secrets.py)
OLLAMA_PROXY_TOKEN=

# Modèles (≤ 8 milliards de paramètres, sujet §3.3)
LLM_MODEL=qwen2.5:7b
# LLM_MODEL=qwen3:8b            # côté PC Hôte : RAG_REASONING=false
EMBED_MODEL=nomic-embed-text
# EMBED_MODEL=bge-m3            # meilleur en français ; recalibrer RAG_MIN_RELEVANCE

# Ressources (VM 32 Go) : vCPU = cœurs physiques attribués à la VM
OLLAMA_MEM_LIMIT=24g
OLLAMA_CPUS=8
OLLAMA_KEEP_ALIVE=60m

# Interface d'écoute du proxy : 0.0.0.0, ou l'IP de la VM sur le réseau de démo
OLLAMA_BIND=0.0.0.0
