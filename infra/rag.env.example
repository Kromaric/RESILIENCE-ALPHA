# Assistant opérateur, partie PC Hôte — copier en infra/.env.
# Le modèle tourne sur la VM dédiée (infra/ollama/, avec son propre .env).
# Les noms de modèles doivent être identiques des deux côtés.

# Adresse du proxy Ollama de la VM
RAG_OLLAMA_BASE_URL=http://192.168.137.20:11434

# Modèle de langage (≤ 8 milliards de paramètres, sujet §3.3) — même valeur que LLM_MODEL sur la VM
RAG_LLM_MODEL=qwen2.5:7b
# Alternative à comparer avec eval/questions.yaml :
# RAG_LLM_MODEL=qwen3:8b
# RAG_REASONING=false           # désactive la phase de réflexion de qwen3 (lente sur CPU)

# Embeddings — même valeur que EMBED_MODEL sur la VM
RAG_EMBED_MODEL=nomic-embed-text
# RAG_EMBED_MODEL=bge-m3        # meilleur en français ; recalibrer le seuil ci-dessous

# Seuil « hors sujet » sur le meilleur extrait (mesuré avec nomic : domaine 0,69–0,78,
# hors sujet 0,62–0,64). À recalibrer avec eval/questions.yaml et à chaque changement d'embeddings.
RAG_MIN_RELEVANCE=0.66

# Une réponse d'un modèle 7–8B sur CPU prend 20 à 60 s selon le processeur
RAG_LLM_TIMEOUT_SECONDS=150
