{
  "openapi": "3.1.0",
  "info": {
    "title": "Orbe — auth-service",
    "description": "Authentification forte des clients Orbe : mot de passe puis **reconnaissance faciale** (modèle InsightFace, test du vivant par rotation de la tête dans un sens tiré au hasard), sessions révocables (JWT RS256 de 15 min), applications clientes et clés d'API partenaires. Exposé par le WAF sous `/api/auth`. Erreurs : `{\"detail\": {\"code\", \"message\"}}`. Voir CADRAGE §4.2.",
    "version": "0.1.0"
  },
  "paths": {
    "/register": {
      "post": {
        "tags": [
          "Authentification"
        ],
        "summary": "Créer un compte",
        "description": "Crée un compte client. Ensuite : `POST /login`, puis `POST /face/enroll` (visage).\n\nHors périmètre du démonstrateur : vérification de l'email et du téléphone, KYC.",
        "operationId": "register_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            }
          },
          "409": {
            "description": "Email ou téléphone déjà utilisé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Email, téléphone ou mot de passe invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "429": {
            "description": "Trop d'inscriptions depuis cette IP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": [
          "Authentification"
        ],
        "summary": "Se connecter — étape 1 : mot de passe",
        "operationId": "login_login_post",
        "parameters": [
          {
            "name": "X-Client-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Client-Id"
            }
          },
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Identifiants ou application cliente invalides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "403": {
            "description": "Application non autorisée pour ce compte",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "423": {
            "description": "Compte bloqué (en-tête Retry-After)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "429": {
            "description": "Trop de tentatives depuis cette IP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/login/face": {
      "post": {
        "tags": [
          "Authentification"
        ],
        "summary": "Se connecter — étape 2 : reconnaissance faciale",
        "description": "Images filmées pendant que la tête tourne dans le sens indiqué par `face_challenge`.\n\nUn échec clôt la tentative (il faut recommencer `POST /login`, avec une nouvelle consigne)\net compte dans le blocage du compte, comme un mauvais mot de passe.",
        "operationId": "login_face_login_face_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FaceLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Visage non reconnu, test du vivant échoué ou session expirée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Images invalides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "429": {
            "description": "Trop de tentatives depuis cette IP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "503": {
            "description": "Reconnaissance faciale indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/logout": {
      "post": {
        "tags": [
          "Authentification"
        ],
        "summary": "Se déconnecter (révoque la session)",
        "operationId": "logout_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Session invalide ou expirée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/me": {
      "get": {
        "tags": [
          "Authentification"
        ],
        "summary": "Mon profil",
        "operationId": "me_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Jeton absent, invalide ou expiré",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/verify": {
      "get": {
        "tags": [
          "Partenaires"
        ],
        "summary": "Vérifier une clé d'API partenaire",
        "operationId": "verify_api_key_verify_get",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResponse"
                }
              }
            }
          },
          "401": {
            "description": "Clé absente, inconnue ou désactivée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/face": {
      "get": {
        "tags": [
          "Visage"
        ],
        "summary": "Mon visage enregistré",
        "operationId": "face_status_face_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaceStatus"
                }
              }
            }
          },
          "401": {
            "description": "Session invalide ou expirée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "403": {
            "description": "Session sans visage alors que le compte en a un",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Visage"
        ],
        "summary": "Supprimer mon visage (droit à l'effacement)",
        "description": "Efface définitivement les gabarits et le consentement. La connexion repassera par\nl'enrôlement du visage.",
        "operationId": "erase_face_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Session invalide ou expirée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "403": {
            "description": "Session sans visage alors que le compte en a un",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/face/enroll": {
      "post": {
        "tags": [
          "Visage"
        ],
        "summary": "Enregistrer (ou remplacer) mon visage",
        "description": "Environ 16 images en tournant lentement la tête de gauche à droite. Seuls 3 à 5\ngabarits (embeddings) sont conservés, chiffrés ; aucune image n'est stockée.",
        "operationId": "enroll_face_enroll_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FaceEnrollRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaceStatus"
                }
              }
            }
          },
          "401": {
            "description": "Session invalide ou expirée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "403": {
            "description": "Session sans visage alors que le compte en a un",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Consentement absent, visage non détecté ou plusieurs personnes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "503": {
            "description": "Reconnaissance faciale indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/operators/login": {
      "post": {
        "tags": [
          "Back-office"
        ],
        "summary": "Connexion d'un opérateur",
        "description": "Mêmes protections que la connexion client : 5 échecs → compte bloqué 10 min,\n20 tentatives par minute et par IP. Pas de reconnaissance faciale.",
        "operationId": "login_operators_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorTokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Identifiants invalides ou compte désactivé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "423": {
            "description": "Compte bloqué (en-tête Retry-After)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "429": {
            "description": "Trop de tentatives depuis cette IP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/operators/logout": {
      "post": {
        "tags": [
          "Back-office"
        ],
        "summary": "Déconnexion d'un opérateur (révoque la session)",
        "operationId": "logout_operators_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Session invalide ou expirée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/operators/me": {
      "get": {
        "tags": [
          "Back-office"
        ],
        "summary": "Opérateur connecté (sert aussi à bo-api pour vérifier la session)",
        "operationId": "me_operators_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorMe"
                }
              }
            }
          },
          "401": {
            "description": "Jeton absent, invalide ou révoqué",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "examples": [
              "invalid_credentials"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message",
            "examples": [
              "Email ou mot de passe incorrect."
            ]
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorOut": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorOut"
      },
      "FaceChallenge": {
        "properties": {
          "direction": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ],
            "title": "Direction"
          },
          "frames": {
            "type": "integer",
            "title": "Frames",
            "description": "Nombre d'images à envoyer"
          },
          "interval_ms": {
            "type": "integer",
            "title": "Interval Ms",
            "description": "Intervalle conseillé entre deux images",
            "default": 250
          }
        },
        "type": "object",
        "required": [
          "direction",
          "frames"
        ],
        "title": "FaceChallenge",
        "description": "Consigne du test du vivant : filmer le visage pendant que la tête tourne dans ce sens."
      },
      "FaceEnrollRequest": {
        "properties": {
          "consent": {
            "type": "boolean",
            "title": "Consent",
            "description": "Consentement explicite au traitement des données biométriques (RGPD art. 9)"
          },
          "frames": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "minItems": 1,
            "title": "Frames",
            "description": "Images JPEG encodées en base64, capturées par la caméra du navigateur"
          }
        },
        "type": "object",
        "required": [
          "consent",
          "frames"
        ],
        "title": "FaceEnrollRequest"
      },
      "FaceLoginRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "title": "Session Id"
          },
          "frames": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Frames",
            "description": "Images JPEG encodées en base64, capturées par la caméra du navigateur"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "frames"
        ],
        "title": "FaceLoginRequest"
      },
      "FaceStatus": {
        "properties": {
          "enrolled": {
            "type": "boolean",
            "title": "Enrolled"
          },
          "templates": {
            "type": "integer",
            "title": "Templates"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "consent_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Consent At"
          }
        },
        "type": "object",
        "required": [
          "enrolled",
          "templates",
          "model",
          "consent_at"
        ],
        "title": "FaceStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "examples": [
          {
            "email": "client@boutique-demo.test",
            "password": "demo-password"
          }
        ]
      },
      "LoginResponse": {
        "properties": {
          "mfa_required": {
            "type": "boolean",
            "title": "Mfa Required"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "face_challenge": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FaceChallenge"
              },
              {
                "type": "null"
              }
            ]
          },
          "token": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TokenResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "face_enrollment_required": {
            "type": "boolean",
            "title": "Face Enrollment Required",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "mfa_required",
          "session_id"
        ],
        "title": "LoginResponse",
        "description": "Étape 1 de la connexion.\n\n- `mfa_required = true` : filmer le visage selon `face_challenge`, puis `POST /login/face` ;\n- sinon : `token` est fourni. `face_enrollment_required = true` signale un compte sans\n  visage enregistré : la session ne permet que de consulter et d'enrôler son visage."
      },
      "MeResponse": {
        "properties": {
          "client_id": {
            "type": "string",
            "title": "Client Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "phone_masked": {
            "type": "string",
            "title": "Phone Masked"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "factors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Factors"
          },
          "face_enrolled": {
            "type": "boolean",
            "title": "Face Enrolled"
          }
        },
        "type": "object",
        "required": [
          "client_id",
          "email",
          "phone_masked",
          "display_name",
          "factors",
          "face_enrolled"
        ],
        "title": "MeResponse"
      },
      "OperatorMe": {
        "properties": {
          "operator_id": {
            "type": "string",
            "title": "Operator Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "role": {
            "type": "string",
            "enum": [
              "viewer",
              "operator"
            ],
            "title": "Role"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "operator_id",
          "email",
          "display_name",
          "role",
          "session_id",
          "expires_at"
        ],
        "title": "OperatorMe"
      },
      "OperatorTokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
